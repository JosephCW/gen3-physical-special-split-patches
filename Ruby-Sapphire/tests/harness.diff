+// Ruby writes scroll registers directly (they can't be read back), so build a
+// readable copy of the display registers for the capture script.
+u16 gTestRegs[0x30];
+static void TestCaptureRegs(u32 id)
+{
+    u32 i;
+    for (i = 0; i < 0x30; i++)
+        gTestRegs[i] = ((vu16 *)REG_ADDR_DISPCNT)[i];
+    for (i = 8; i < 16; i++)
+        gTestRegs[i] = 0;
+    if (id <= 6 || id == 10) // summary screen scrolls its backgrounds through these variables
+    {
+        gTestRegs[8] = gBattle_BG0_X;  gTestRegs[9] = gBattle_BG0_Y;
+        gTestRegs[10] = gBattle_BG1_X; gTestRegs[11] = gBattle_BG1_Y;
+        gTestRegs[12] = gBattle_BG2_X; gTestRegs[13] = gBattle_BG2_Y;
+        gTestRegs[14] = gBattle_BG3_X; gTestRegs[15] = gBattle_BG3_Y;
+    }
+}
