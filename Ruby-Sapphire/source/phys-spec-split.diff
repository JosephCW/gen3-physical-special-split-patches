+// Type and physical/special/status icons for the selected TM/HM, stacked in the
+// empty space left of the bag. They use the summary screen's move type sprites.
+extern const u8 gMoveTypes_Pal[];
+#define TAG_TM_ICON_PAL 30030 // + 0, 1, 2 for the three move type palettes
+#define TM_ICON_X 1
+#define TM_ICON_Y 22
+
+static void LoadTmIconGfx(void)
+{
+    struct SpritePalette pal;
+    u8 i;
+
+    LoadCompressedObjectPic(&gSpriteSheet_MoveTypes);
+    LZDecompressWram(gMoveTypes_Pal, gDecompressionBuffer);
+    for (i = 0; i < 3; i++)
+    {
+        pal.data = (const u16 *)gDecompressionBuffer + i * 16;
+        pal.tag = TAG_TM_ICON_PAL + i;
+        LoadSpritePalette(&pal);
+    }
+}
+
+static void CreateTmIconSprites(void)
+{
+    struct SpriteTemplate template = {
+        .tileTag = TAG_MOVE_TYPES,
+        .paletteTag = TAG_TM_ICON_PAL,
+        .oam = &gOamData_MoveTypes,
+        .anims = gSpriteAnimTable_MoveTypes,
+        .images = NULL,
+        .affineAnims = gDummySpriteAffineAnimTable,
+        .callback = SpriteCB_TmIcon,
+    };
+    u8 i;
+
+    for (i = 0; i < 2; i++)
+    {
+        u8 spriteId = CreateSprite(&template, TM_ICON_X + 16, TM_ICON_Y + 8 + i * 18, 0);
+        gSprites[spriteId].data[0] = i; // 0 = type, 1 = category
+        gSprites[spriteId].invisible = TRUE;
+    }
+}
+
+// Works out the selected TM itself every frame, so no other bag code has to update it
+static void SpriteCB_TmIcon(struct Sprite *sprite)
+{
+    struct PocketScrollState *scroll = &gBagPocketScrollStates[sCurrentBagPocket];
+    u16 index = scroll->scrollTop + scroll->cursorPos;
+    u16 move;
+    u8 frame;
+
+    // Hidden outside the TMs & HMs pocket, while pockets slide, and on the CLOSE BAG row
+    if (sCurrentBagPocket != BAG_POCKET_TMs_HMs || gUnknown_0203855A != 16
+     || index >= scroll->numSlots || gCurrentBagPocketItemSlots[index].itemId == ITEM_NONE)
+    {
+        sprite->invisible = TRUE;
+        return;
+    }
+    move = ItemIdToBattleMoveId(gCurrentBagPocketItemSlots[index].itemId);
+    if (sprite->data[0] == 0)
+        frame = gBattleMoves[move].type;
+    else
+        frame = SPLIT_ICON_FRAME(gBattleMoves[move].split);
+    if (sprite->animNum != frame)
+    {
+        StartSpriteAnim(sprite, frame);
+        sprite->oam.paletteNum = IndexOfSpritePaletteTag(TAG_TM_ICON_PAL + gMoveTypeToOamPaletteNum[frame] - 13);
+    }
+    sprite->invisible = FALSE;
+}
