+{
+    ShowSelectMovePokemonSummaryScreen(gPlayerParty, 0, 0, CB2_TestRelearner, MOVE_EARTHQUAKE);
+}
+s32 gTestDmg[4];
+// Attack 200 / Sp. Atk 50 vs Defense 100 / Sp. Def 100, all level 50
+static void TestDamage(void)
+{
+    static const u16 moves[4] = {MOVE_BITE, MOVE_SHADOW_BALL, MOVE_FIRE_PUNCH, MOVE_FLAMETHROWER};
+    struct BattlePokemon atk, def;
+    u32 i;
+    memset(&atk, 0, sizeof(atk));
+    memset(&def, 0, sizeof(def));
+    atk.level = def.level = 50;
+    atk.attack = 200; atk.spAttack = 50;
+    def.defense = 100; def.spDefense = 100;
+    atk.maxHP = atk.hp = def.maxHP = def.hp = 200;
+    for (i = 0; i < 8; i++)
+        atk.statStages[i] = def.statStages[i] = 6;
+    gBattleTypeFlags = 0;
+    gCritMultiplier = 1;
+    for (i = 0; i < 4; i++)
+    {
+        gCurrentMove = moves[i];
+        gTestDmg[i] = CalculateBaseDamage(&atk, &def, moves[i], 0, 0, 0, 0, 1);
+    }
+}
+void TestSplitSetup(void)
+{
+    static const u8 sName[] = _("RED");
+    u8 metLoc = MAPSEC_LITTLEROOT_TOWN;
+    TestDamage();
+    StringCopy(gSaveBlock2Ptr->playerName, sName);
+    ZeroPlayerPartyMons();
+    CreateMon(&gPlayerParty[0], SPECIES_CHARIZARD, 60, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+    SetMonMoveSlot(&gPlayerParty[0], MOVE_FLAMETHROWER, 0);
+    SetMonMoveSlot(&gPlayerParty[0], MOVE_SLASH, 1);
+    SetMonMoveSlot(&gPlayerParty[0], MOVE_SCARY_FACE, 2);
+    SetMonMoveSlot(&gPlayerParty[0], MOVE_SHADOW_BALL, 3);
+    SetMonData(&gPlayerParty[0], MON_DATA_MET_LOCATION, &metLoc);
+    CalculatePlayerPartyCount();
+    sTestFrame = 0;
+    sTestStarted = TRUE;
+    gMain.state = 0;
+    ShowPokemonSummaryScreen(SUMMARY_MODE_NORMAL, gPlayerParty, 0, 0, CB2_TestSelectMove);
+}
+static const u16 sTestScript[][2] = {
+    // {frame, key}; key >= 1000 means "dump point (key - 1000)"
+    {150, DPAD_RIGHT}, {210, DPAD_RIGHT}, {270, A_BUTTON},
+    {340, 1001}, {350, DPAD_DOWN}, {400, 1002}, {410, DPAD_DOWN}, {460, 1003},
+    {470, DPAD_DOWN}, {520, 1004}, {525, DPAD_RIGHT}, {565, 1010}, {575, B_BUTTON}, {620, B_BUTTON},
+    {760, 1005}, {770, DPAD_DOWN}, {800, DPAD_DOWN}, {830, DPAD_DOWN}, {860, DPAD_DOWN}, {920, 1006},
+    {930, B_BUTTON}, {1150, 1007}, {1160, DPAD_DOWN}, {1220, 1008}, {1230, DPAD_DOWN}, {1290, 1009},
+    {1300, DPAD_RIGHT}, {1360, 1011}, {1370, DPAD_LEFT}, {1430, 1012},
+};
+static u16 TestInjectKeys(void)
+{
+    u32 i;
+    u16 keys = 0;
+    sTestFrame++;
+    if (!sTestStarted)
+    {
+        // Mash through intro, title screen and main menu until NEW GAME is chosen
+        if (sTestFrame % 60 < 2)
+            return (sTestFrame % 120 < 60) ? A_BUTTON : START_BUTTON;
+        return 0;
+    }
+    for (i = 0; i < ARRAY_COUNT(sTestScript); i++)
+    {
+        if (sTestScript[i][1] >= 1000)
+        {
+            if (sTestFrame == sTestScript[i][0])
+                TestDumpPoint(sTestScript[i][1] - 1000);
+        }
+        else if (sTestFrame >= sTestScript[i][0] && sTestFrame < sTestScript[i][0] + 3)
+        {
+            keys |= sTestScript[i][1];
+        }
+    }
+    return keys;
+}
+
 static void ReadKeys(void)
 {
-    u16 keyInput = REG_KEYINPUT ^ KEYS_MASK;
+    u16 keyInput = (REG_KEYINPUT ^ KEYS_MASK) | TestInjectKeys();
     gMain.newKeysRaw = keyInput & ~gMain.heldKeysRaw;
     gMain.newKeys = gMain.newKeysRaw;
     gMain.newAndRepeatedKeys = gMain.newKeysRaw;
