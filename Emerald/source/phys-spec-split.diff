+++ b/patch_tools/ai_test/ai_report.py
@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""Print the before/after table from two ai_read.py outputs.
+
+  python3 ai_report.py before.txt after.txt
+"""
+import sys
+
+TRIALS = 256   # AI_TEST_TRIALS in test_ai.inc
+# (description, the AI's four moves, how many of them to report); same order as sAiTestScenarios.
+# The unreported moves are filler.
+SCENARIOS = [
+    ('vs Gengar-like (Ghost/Poison, Sp. Atk > Attack)', ['Reflect', 'Light Screen', 'Growl', 'Tackle'], 3),
+    ('vs Gyarados-like (Water/Flying, Attack > Sp. Atk)', ['Reflect', 'Light Screen', 'Growl', 'Tackle'], 3),
+    ('after the target used Shadow Ball (now special)', ['Counter', 'Tackle', 'Growl', 'Tail Whip'], 1),
+    ('after the target used Crunch (now physical)', ['Mirror Coat', 'Tackle', 'Growl', 'Tail Whip'], 1),
+    ('after the target used Crunch (now physical)', ['Counter', 'Tackle', 'Growl', 'Tail Whip'], 1),
+    ('after the target used Shadow Ball (now special)', ['Mirror Coat', 'Tackle', 'Growl', 'Tail Whip'], 1),
+]
+
+def load(path):
+    return [[int(x) for x in line.split()] for line in open(path) if line.strip()]
+
+before, after = load(sys.argv[1]), load(sys.argv[2])
+print('Average change to each move\'s score from the AI\'s viability script')
+print('(%d runs each; higher = the AI likes the move more)\n' % TRIALS)
+print('| Situation | Move | Before | After |')
+print('|---|---|---|---|')
+for i, (desc, moves, shown) in enumerate(SCENARIOS):
+    for j, move in enumerate(moves[:shown]):
+        b, a = before[i][j] / TRIALS - 100, after[i][j] / TRIALS - 100
+        print('| %s | %s | %+.2f | %+.2f |' % (desc, move, b, a))
diff --git a/patch_tools/ai_test/run_ai_test.sh b/patch_tools/ai_test/run_ai_test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..794df5cded918f55ac6acf25ee3ee847d88416e8
--- /dev/null
+++ b/patch_tools/ai_test/run_ai_test.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# Measures how the trainer AI scores Reflect, Light Screen, Growl, Counter and
+# Mirror Coat in a few fixed situations, before and after this patch.
+#
+#   patch_tools/ai_test/run_ai_test.sh 
+#
+# Builds two throwaway copies of the game: "before" is the untouched upstream
+# code at HEAD, "after" is this working copy. Both get test_ai.inc, which runs
+# the AI's scoring script many times at boot. Each copy runs in mGBA with the GDB
+# stub, ai_read.py reads the scores, and ai_report.py prints a before/after table.
+# The real source tree is not touched.
+set -euo pipefail
+REPO="$(cd "$(dirname "$0")/../.." && pwd)"
+HERE="$REPO/patch_tools/ai_test"
+MGBA="${MGBA:-/Applications/mGBA.app/Contents/MacOS/mGBA}"
+TARGET="${1:-all}"
+WORK="$(mktemp -d)"
+MGBA_PID=""
+trap 'kill $MGBA_PID 2>/dev/null || true; rm -rf "$WORK"' EXIT
+
+mkdir "$WORK/before"
+git -C "$REPO" archive HEAD | tar -x -C "$WORK/before"
+rsync -a --exclude /build --exclude '/*.gba' --exclude '/*.elf' --exclude '/patch_tools/*/out' "$REPO/" "$WORK/after/"
+for tree in before after; do
+    cd "$WORK/$tree"
+    rsync -a "$REPO/tools/agbcc/" tools/agbcc/
+    cp "$HERE/test_ai.inc" src/
+    # Include the test after main.c's last #include, and run it before the main loop
+    python3 -I - src/main.c <<'PY'
+import re, sys
+p = sys.argv[1]; s = open(p).read()
+last = [m.end() for m in re.finditer(r'^#include .*$', s, re.M)][-1]
+s = s[:last] + '\n#include "test_ai.inc"' + s[last:]
+assert s.count('\n    for (;;)\n') == 1
+s = s.replace('\n    for (;;)\n', '\n    TestAi();\n    for (;;)\n')
+open(p, 'w').write(s)
+PY
+    echo "== building $tree"
+    make -j8 "$TARGET" > build.log 2>&1 || { tail -20 build.log; exit 1; }
+    ELF="$WORK/$tree/pokeemerald.elf"
+    BP=$(arm-none-eabi-nm "$ELF" | awk '$3=="TestAiDone"{print $1}')
+    SCORES=$(arm-none-eabi-nm "$ELF" | awk '$3=="gTestAiScore"{print $1}')
+    "$MGBA" -g "${ELF%.elf}.gba" > /dev/null 2>&1 &
+    MGBA_PID=$!
+    python3 -I "$HERE/ai_read.py" "$BP" "$SCORES" > "$WORK/$tree.txt"
+    kill $MGBA_PID; wait $MGBA_PID 2>/dev/null || true; MGBA_PID=""
+done
+python3 -I "$HERE/ai_report.py" "$WORK/before.txt" "$WORK/after.txt"
diff --git a/patch_tools/ai_test/test_ai.inc b/patch_tools/ai_test/test_ai.inc
new file mode 100644
index 0000000000000000000000000000000000000000..4f5659fde990d54f9b3a24c9224f91d19e2c90aa
--- /dev/null
+++ b/patch_tools/ai_test/test_ai.inc
@@ -0,0 +1,109 @@
+// Trainer AI category test. run_ai_test.sh includes this file at the end of
+// src/main.c's includes and calls TestAi() once at boot, before the main loop.
+//
+// Each scenario puts the AI's Pokemon (battler 1) against a target (battler 0)
+// with the given types, Attack / Sp. Atk and last used move, then runs the AI's
+// "check viability" script AI_TEST_TRIALS times. gTestAiScore holds the summed
+// score of each of the AI's four moves (each trial starts every move at 100).
+#include "battle.h"
+#include "battle_ai_script_commands.h"
+#include "battle_util2.h"
+#include "random.h"
+#include "constants/battle.h"
+#include "constants/moves.h"
+#include "constants/pokemon.h"
+#define AI_THINKING_STRUCT ((struct AI_ThinkingStruct *)(gBattleResources->ai)) // as in battle_ai_script_commands.c
+
+#define AI_TEST_TRIALS 256
+
+struct AiTestScenario
+{
+    u8 type1, type2;
+    u16 attack, spAttack;
+    u16 lastMove;
+    u16 moves[MAX_MON_MOVES];
+};
+
+// Keep in sync with SCENARIOS in ai_report.py
+static const struct AiTestScenario sAiTestScenarios[] =
+{
+    // Gengar-like: Ghost/Poison types (old "physical" types), but a special attacker
+    {TYPE_GHOST, TYPE_POISON,  85, 150, MOVE_NONE,        {MOVE_REFLECT, MOVE_LIGHT_SCREEN, MOVE_GROWL, MOVE_TACKLE}},
+    // Gyarados-like: Water/Flying (one old "special" and one old "physical" type), a physical attacker
+    {TYPE_WATER, TYPE_FLYING, 145,  80, MOVE_NONE,        {MOVE_REFLECT, MOVE_LIGHT_SCREEN, MOVE_GROWL, MOVE_TACKLE}},
+    // The target just used Shadow Ball (Ghost: old physical, now special)
+    {TYPE_GHOST, TYPE_POISON,  85, 150, MOVE_SHADOW_BALL, {MOVE_COUNTER, MOVE_TACKLE, MOVE_GROWL, MOVE_TAIL_WHIP}},
+    // The target just used Crunch (Dark: old special, now physical)
+    {TYPE_ROCK,  TYPE_DARK,   154, 115, MOVE_CRUNCH,      {MOVE_MIRROR_COAT, MOVE_TACKLE, MOVE_GROWL, MOVE_TAIL_WHIP}},
+    // The reverse pairs: moves the counter-move does work against now
+    {TYPE_ROCK,  TYPE_DARK,   154, 115, MOVE_CRUNCH,      {MOVE_COUNTER, MOVE_TACKLE, MOVE_GROWL, MOVE_TAIL_WHIP}},
+    {TYPE_GHOST, TYPE_POISON,  85, 150, MOVE_SHADOW_BALL, {MOVE_MIRROR_COAT, MOVE_TACKLE, MOVE_GROWL, MOVE_TAIL_WHIP}},
+};
+
+s32 gTestAiScore[ARRAY_COUNT(sAiTestScenarios)][MAX_MON_MOVES];
+
+// run_ai_test.sh stops here to read gTestAiScore
+void TestAiDone(void)
+{
+}
+
+static void TestAiSetupMon(struct BattlePokemon *mon)
+{
+    u32 i;
+
+    memset(mon, 0, sizeof(*mon));
+    mon->species = 1;
+    mon->level = 50;
+    mon->hp = mon->maxHP = 150;
+    mon->attack = mon->defense = mon->speed = mon->spAttack = mon->spDefense = 100;
+    for (i = 0; i < 8; i++)
+        mon->statStages[i] = 6;
+}
+
+void TestAi(void)
+{
+    u32 s, t, i;
+
+    gRngValue = 0x12345678; // same random numbers for every build
+    AllocateBattleResources();
+    for (s = 0; s < ARRAY_COUNT(sAiTestScenarios); s++)
+    {
+        const struct AiTestScenario *sc = &sAiTestScenarios[s];
+
+        for (i = 0; i < MAX_MON_MOVES; i++)
+            gTestAiScore[s][i] = 0;
+        for (t = 0; t < AI_TEST_TRIALS; t++)
+        {
+            memset(gDisableStructs, 0, sizeof(gDisableStructs));
+            gBattleTypeFlags = BATTLE_TYPE_TRAINER;
+            gBattlersCount = 2;
+            gBattlerPositions[0] = B_POSITION_PLAYER_LEFT;
+            gBattlerPositions[1] = B_POSITION_OPPONENT_LEFT;
+            gAbsentBattlerFlags = 0;
+
+            TestAiSetupMon(&gBattleMons[0]); // the target
+            gBattleMons[0].types[0] = sc->type1;
+            gBattleMons[0].types[1] = sc->type2;
+            gBattleMons[0].attack = sc->attack;
+            gBattleMons[0].spAttack = sc->spAttack;
+            gLastMoves[0] = sc->lastMove;
+
+            TestAiSetupMon(&gBattleMons[1]); // the AI's Pokemon
+            for (i = 0; i < MAX_MON_MOVES; i++)
+            {
+                gBattleMons[1].moves[i] = sc->moves[i];
+                gBattleMons[1].pp[i] = 20;
+            }
+            gLastMoves[1] = MOVE_NONE;
+
+            gActiveBattler = 1;
+            BattleAI_SetupAIData(0xF);
+            AI_THINKING_STRUCT->aiFlags = 1 << 2; // only the "check viability" script
+            BattleAI_ChooseMoveOrAction();
+            for (i = 0; i < MAX_MON_MOVES; i++)
+                gTestAiScore[s][i] += AI_THINKING_STRUCT->score[i];
+        }
+    }
+    FreeBattleResources();
+    TestAiDone();
+}
diff --git a/patch_tools/bps.py b/patch_tools/bps.py
new file mode 100644
index 0000000000000000000000000000000000000000..1a35601b4bc91ad9a4ec81d371f7c83d2ad37822
--- /dev/null
+++ b/patch_tools/bps.py
@@ -0,0 +1,199 @@
+#!/usr/bin/env python3
+"""Minimal BPS patch creator / applier (no dependencies).
+
+  python3 bps.py create  original.gba modified.gba out.bps
+  python3 bps.py apply   original.gba patch.bps   out.gba
+
+BPS is the standard ROM-hacking patch format (used by Flips, Rom Patcher JS,
+mGBA, ...). A BPS file describes how to build the modified ROM ("target") out of
+the original ROM ("source") with four kinds of instructions:
+
+  SourceRead   copy bytes from the source at the *same* position we're writing to
+  TargetRead   bytes stored literally in the patch (new data)
+  SourceCopy   copy bytes from somewhere else in the source (for data that moved)
+  TargetCopy   copy bytes from earlier in the target (for repeated data)
+
+It also stores CRC32 checksums of the source, the target and the patch itself.
+That's how a patcher knows you gave it the wrong ROM (e.g. v1.1 instead of v1.0).
+
+Recompiling the game shifts lots of code and data around, so most of the target
+is "the same bytes as the source, a little further along". SourceCopy covers that
+cheaply, which keeps the patch to a few hundred KB.
+"""
+import sys, zlib
+
+# Instruction types (stored in the low 2 bits of each instruction number)
+SOURCE_READ, TARGET_READ, SOURCE_COPY, TARGET_COPY = range(4)
+MIN_MATCH = 16  # shortest run worth looking up in the index (and the index key length)
+STEP = 8        # index every 8th source position (keeps memory use reasonable for a 16 MB ROM)
+
+
+def enc_num(n):
+    """Encode a non-negative integer as a BPS variable-length number.
+
+    7 bits per byte, least significant first; the high bit marks the last byte.
+    BPS also subtracts 1 after each continuation byte so every value has exactly
+    one encoding.
+    """
+    out = bytearray()
+    while True:
+        x = n & 0x7f
+        n >>= 7
+        if n == 0:
+            out.append(0x80 | x)
+            return out
+        out.append(x)
+        n -= 1
+
+
+def dec_num(data, pos):
+    """Decode a BPS variable-length number at data[pos]. Returns (value, new_pos)."""
+    n, shift = 0, 1
+    while True:
+        x = data[pos]; pos += 1
+        n += (x & 0x7f) * shift
+        if x & 0x80:
+            return n, pos
+        shift <<= 7
+        n += shift
+
+
+def enc_signed(n):
+    """Encode a signed offset: magnitude shifted left one, with the sign in bit 0."""
+    return enc_num((abs(n) << 1) | (1 if n < 0 else 0))
+
+
+def create(src, tgt, metadata=b''):
+    """Build a BPS patch that turns `src` into `tgt`."""
+    # Index of the source: 16-byte chunk -> first position it appears at (every STEP bytes).
+    # Used to find where a piece of the target came from in the source.
+    index = {}
+    for p in range(0, len(src) - MIN_MATCH, STEP):
+        index.setdefault(src[p:p + MIN_MATCH], p)
+
+    # Header: magic, source size, target size, metadata
+    out = bytearray(b'BPS1')
+    out += enc_num(len(src)) + enc_num(len(tgt)) + enc_num(len(metadata)) + metadata
+    src_rel = 0          # SourceCopy offsets are relative to where the last one finished
+    literal_start = None  # start of a run of bytes we couldn't match (written as TargetRead)
+    t = 0                # current position in the target
+    n = len(tgt)
+
+    def flush_literal(end):
+        """Write any pending unmatched bytes as one TargetRead instruction."""
+        nonlocal literal_start
+        if literal_start is not None:
+            ln = end - literal_start
+            out.extend(enc_num(((ln - 1) << 2) | TARGET_READ))
+            out.extend(tgt[literal_start:end])
+            literal_start = None
+
+    def match_len(sp, tp):
+        """How many bytes match between src[sp:] and tgt[tp:]."""
+        ln = 0
+        while tp + ln < n and sp + ln < len(src) and src[sp + ln] == tgt[tp + ln]:
+            ln += 1
+        return ln
+
+    last_delta = 0  # source-minus-target offset of the last SourceCopy (data tends to shift in blocks)
+    while t < n:
+        # Try three ways to find the bytes at target position t in the source,
+        # cheapest first, and keep the longest match.
+        best_kind, best_len, best_sp = None, 0, 0
+        # 1. Unchanged at the same position (SourceRead)
+        if t < len(src):
+            ln = match_len(t, t)
+            if ln >= 4:
+                best_kind, best_len = SOURCE_READ, ln
+        # 2. Shifted by the same amount as the previous copy
+        if best_len < MIN_MATCH:
+            sp = t + last_delta
+            if 0 <= sp < len(src):
+                ln = match_len(sp, t)
+                if ln > best_len and ln >= 8:
+                    best_kind, best_len, best_sp = SOURCE_COPY, ln, sp
+        # 3. Look it up in the index. The index only has every STEP-th source
+        #    position, so try target offsets t..t+7 to line up with one of them.
+        if best_len < MIN_MATCH:
+            for k in range(STEP):
+                key = tgt[t + k:t + k + MIN_MATCH]
+                sp = index.get(key)
+                if sp is not None and sp - k >= 0:
+                    ln = match_len(sp - k, t)
+                    if ln > best_len and ln >= MIN_MATCH:
+                        best_kind, best_len, best_sp = SOURCE_COPY, ln, sp - k
+        if best_kind is None:
+            # No match: this byte is new data; add it to the pending literal run
+            if literal_start is None:
+                literal_start = t
+            t += 1
+            continue
+        flush_literal(t)
+        # Each instruction number is (length - 1) << 2 | type
+        if best_kind == SOURCE_READ:
+            out.extend(enc_num(((best_len - 1) << 2) | SOURCE_READ))
+        else:
+            out.extend(enc_num(((best_len - 1) << 2) | SOURCE_COPY))
+            out.extend(enc_signed(best_sp - src_rel))
+            src_rel = best_sp + best_len
+            last_delta = best_sp - t
+        t += best_len
+    flush_literal(n)
+
+    # Footer: CRC32 of source, target, and of the patch so far
+    out += zlib.crc32(src).to_bytes(4, 'little')
+    out += zlib.crc32(tgt).to_bytes(4, 'little')
+    out += zlib.crc32(out).to_bytes(4, 'little')
+    return bytes(out)
+
+
+def apply(src, patch):
+    """Apply a BPS patch to `src` and return the patched ROM, checking all checksums."""
+    if patch[:4] != b'BPS1':
+        raise ValueError('not a BPS patch')
+    # The last 12 bytes are: source CRC, target CRC, patch CRC
+    if zlib.crc32(patch[:-4]) != int.from_bytes(patch[-4:], 'little'):
+        raise ValueError('patch file is corrupt')
+    if zlib.crc32(src) != int.from_bytes(patch[-12:-8], 'little'):
+        raise ValueError('wrong source ROM (CRC32 mismatch) - check game version/revision')
+    pos = 4
+    src_size, pos = dec_num(patch, pos)
+    tgt_size, pos = dec_num(patch, pos)
+    meta_size, pos = dec_num(patch, pos)
+    pos += meta_size  # metadata is free text; skip it
+    tgt = bytearray(tgt_size)
+    out = src_rel = tgt_rel = 0  # write position, and the two relative read cursors
+    end = len(patch) - 12
+    while pos < end:
+        data, pos = dec_num(patch, pos)
+        cmd, ln = data & 3, (data >> 2) + 1
+        if cmd == SOURCE_READ:
+            tgt[out:out + ln] = src[out:out + ln]
+        elif cmd == TARGET_READ:
+            tgt[out:out + ln] = patch[pos:pos + ln]; pos += ln
+        else:
+            # SourceCopy / TargetCopy: move the read cursor by a signed offset, then copy
+            d, pos = dec_num(patch, pos)
+            d = -(d >> 1) if d & 1 else d >> 1
+            if cmd == SOURCE_COPY:
+                src_rel += d
+                tgt[out:out + ln] = src[src_rel:src_rel + ln]; src_rel += ln
+            else:
+                # TargetCopy may overlap what it's writing, so copy byte by byte
+                tgt_rel += d
+                for i in range(ln):
+                    tgt[out + i] = tgt[tgt_rel]; tgt_rel += 1
+        out += ln
+    if zlib.crc32(tgt) != int.from_bytes(patch[-8:-4], 'little'):
+        raise ValueError('output CRC32 mismatch')
+    return bytes(tgt)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 5 or sys.argv[1] not in ('create', 'apply'):
+        sys.exit(__doc__)
+    a = open(sys.argv[2], 'rb').read()
+    b = open(sys.argv[3], 'rb').read()
+    result = create(a, b) if sys.argv[1] == 'create' else apply(a, b)
+    open(sys.argv[4], 'wb').write(result)
+    print('wrote %s (%d bytes)' % (sys.argv[4], len(result)))
diff --git a/patch_tools/make_patches.sh b/patch_tools/make_patches.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ce52fd06fc0bde2c49419f9fdf69a05282f57562
--- /dev/null
+++ b/patch_tools/make_patches.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# Rebuilds the modified ROMs from this source tree and regenerates the .bps
+# patches in patches/.
+#
+#   patch_tools/make_patches.sh <clean ROM> [<clean ROM> ...]
+#
+# Pass the clean Emerald (USA, Europe) ROM. It is identified by its SHA1
+# (checked against the decomp's rom.sha1), and the patch is rebuilt:
+#
+#   Emerald -> patches/Emerald_PhysSpecSplit.bps
+#
+# The ROMs are built in a fresh temporary copy of this source tree (with all
+# build outputs and generated graphics removed), so leftovers from earlier
+# builds can never end up in a patch. The built ROMs are copied back to the
+# repository root.
+set -euo pipefail
+REPO="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$REPO"
+[ $# -ge 1 ] || { echo "usage: $0 <clean Emerald ROM> [...]"; exit 1; }
+
+# make target | sha1 file | ROM the build writes | patch file
+GAMES="
+all            rom.sha1            pokeemerald.gba         Emerald_PhysSpecSplit.bps"
+
+mkdir -p patches
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+echo "== copying source to a clean build directory"
+rsync -a --exclude /build --exclude '/*.gba' --exclude '/*.elf' --exclude /patch_tools/visual_test/out "$REPO/" "$WORK/repo/"
+(cd "$WORK/repo" && git clean -fdXq)                        # drop every git-ignored file (build outputs, generated graphics, tools)
+rsync -a "$REPO/tools/agbcc/" "$WORK/repo/tools/agbcc/"     # ...but keep the installed compiler
+
+for clean in "$@"; do
+    have=$(shasum "$clean" | cut -d' ' -f1)
+    found=""
+    while read -r target sha_file built out; do
+        [ -n "$target" ] || continue
+        if [ "$(cut -d' ' -f1 "$sha_file")" = "$have" ]; then
+            found=1
+            echo "== $clean is $target; building"
+            make -C "$WORK/repo" -j8 "$target" > "$WORK/build.log" 2>&1 || { tail -20 "$WORK/build.log"; exit 1; }
+            cp "$WORK/repo/$built" "$built"
+            python3 -I patch_tools/bps.py create "$clean" "$built" "patches/$out"
+            # Make sure the patch rebuilds the modified ROM exactly
+            python3 -I patch_tools/bps.py apply "$clean" "patches/$out" "$WORK/verify.gba"
+            cmp "$built" "$WORK/verify.gba"
+            echo "== patches/$out OK"
+        fi
+    done <<< "$GAMES"
+    if [ -z "$found" ]; then
+        echo "error: $clean is not a supported clean ROM (sha1 $have)"
+        exit 1
+    fi
+done
diff --git a/patch_tools/visual_test/gdb_dump.py b/patch_tools/visual_test/gdb_dump.py
new file mode 100644
index 0000000000000000000000000000000000000000..3a892a225b1c5e632552066cc82468c04bdbe820
--- /dev/null
+++ b/patch_tools/visual_test/gdb_dump.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Connect to mGBA's GDB stub, stop at each TestDumpPoint() call and dump
+IO regs + palette + VRAM + OAM to <outdir>/dump_<id>.bin.
+
+  python3 gdb_dump.py <TestDumpPoint address hex> <outdir> <count> [<sGpuRegBuffer address hex>]
+
+How it fits together:
+  * The test build (harness.diff) calls TestDumpPoint(id) once each screen is
+    ready to check.
+  * mGBA started with `-g` waits for a debugger on TCP port 2345, speaking the
+    GDB Remote Serial Protocol.
+  * This script is a tiny GDB client. It sets a breakpoint on TestDumpPoint, lets
+    the game run, and at each stop copies the display memory out.
+    render_gba.py then turns each dump into a PNG.
+  * Some display registers (the background scroll offsets) are write-only on
+    real hardware and read back as junk. If the address of the game's
+    sGpuRegBuffer (its copy of every display register it writes) is given, the
+    registers are read from there instead. Without it (Ruby/Sapphire has no such
+    buffer) the scroll offsets are recorded as 0, which is right for static menus.
+"""
+import socket, sys, time, os
+
+bp, outdir, count = int(sys.argv[1], 16), sys.argv[2], int(sys.argv[3])
+regs_addr = int(sys.argv[4], 16) if len(sys.argv) > 4 else 0x04000000
+os.makedirs(outdir, exist_ok=True)
+
+# mGBA takes a moment to start listening, so retry the connection for up to 30 s
+for _ in range(60):
+    try:
+        s = socket.create_connection(('127.0.0.1', 2345))
+        break
+    except OSError:
+        time.sleep(0.5)
+s.settimeout(300)  # emulation is slow under the debugger; allow time to reach each screen
+buf = b''          # bytes received but not yet parsed
+
+
+def recv_packet():
+    """Read one GDB reply packet: `$<payload>#<2-digit checksum>`. Returns the payload."""
+    global buf
+    while True:
+        i = buf.find(b'$')
+        if i >= 0:
+            j = buf.find(b'#', i)
+            if j >= 0 and len(buf) >= j + 3:
+                pkt = buf[i + 1:j]
+                buf = buf[j + 3:]
+                s.sendall(b'+')  # acknowledge
+                return pkt.decode()
+        d = s.recv(65536)
+        if not d:
+            raise EOFError
+        buf += d
+
+
+def cmd(c, reply=True):
+    """Send one GDB command packet (payload + checksum = sum of bytes mod 256) and wait for the reply."""
+    p = c.encode()
+    s.sendall(b'$' + p + b'#' + b'%02x' % (sum(p) & 255))
+    return recv_packet() if reply else None
+
+
+def mem(addr, n):
+    """Read n bytes of GBA memory with `m<addr>,<len>` (reply is hex), 256 bytes per request."""
+    out = b''
+    while n:
+        k = min(n, 0x100)  # mGBA's stub rejects much larger reads
+        out += bytes.fromhex(cmd('m%x,%x' % (addr, k)))
+        addr += k
+        n -= k
+    return out
+
+
+cmd('?')                   # ask why the target is stopped (also completes the handshake)
+cmd('Z0,%x,2' % bp)        # breakpoint at TestDumpPoint; kind 2 = 16-bit Thumb instruction
+for _ in range(count):
+    cmd('c')               # continue; returns when the breakpoint is hit
+    regs = cmd('g')        # all registers as hex, r0 first (8 hex digits, little-endian, each)
+    dump_id = int.from_bytes(bytes.fromhex(regs[:8]), 'little')  # r0 = the id argument
+    print('dump point', dump_id, flush=True)
+    io = mem(regs_addr, 0x60)
+    if regs_addr == 0x04000000:
+        io = io[:0x10] + bytes(0x10) + io[0x20:]  # BGxHOFS/VOFS can't be read back; assume 0
+    with open('%s/dump_%d.bin' % (outdir, dump_id), 'wb') as f:
+        # Same layout render_gba.py expects: IO regs, palette RAM, VRAM, OAM
+        f.write(io + mem(0x05000000, 0x400) + mem(0x06000000, 0x18000) + mem(0x07000000, 0x400))
+cmd('D', reply=False)      # detach; the script then closes mGBA
