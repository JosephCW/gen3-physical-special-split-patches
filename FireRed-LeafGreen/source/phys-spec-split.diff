diff --git a/patch_tools/visual_test/run_visual_test.sh b/patch_tools/visual_test/run_visual_test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..c4323dddd904ca7d34c84a280a31d6279a54f734
--- /dev/null
+++ b/patch_tools/visual_test/run_visual_test.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Builds a throwaway, self-driving copy of the modified game that opens the
+# summary screen / "forget a move" screen / Move Relearner, runs it in mGBA with
+# the GDB stub, and renders PNGs of each screen into patch_tools/visual_test/out/.
+# The real source tree is not touched.
+#
+#   patch_tools/visual_test/run_visual_test.sh [leafgreen|firered]   (default: leafgreen)
+set -euo pipefail
+REPO="$(cd "$(dirname "$0")/../.." && pwd)"
+HERE="$REPO/patch_tools/visual_test"
+MGBA="${MGBA:-/Applications/mGBA.app/Contents/MacOS/mGBA}"
+GAME="${1:-leafgreen}"
+case "$GAME" in leafgreen|firered) ;; *) echo "usage: $0 [leafgreen|firered]"; exit 1 ;; esac
+WORK="$(mktemp -d)"
+MGBA_PID=""
+trap 'kill $MGBA_PID 2>/dev/null || true; rm -rf "$WORK"' EXIT
+
+rsync -a --exclude /build --exclude '/*.gba' --exclude '/*.elf' --exclude /patch_tools/visual_test/out "$REPO/" "$WORK/repo/"
+cd "$WORK/repo"
+git apply "$HERE/harness.diff"
+sed -i.bak 's/^static void CB2_MoveRelearner_Init(void)/void CB2_MoveRelearner_Init(void)/' src/learn_move.c
+make -j8 "$GAME" > build.log 2>&1 || { tail -20 build.log; exit 1; }
+
+BP=$(arm-none-eabi-nm "poke$GAME.elf" | awk '$3=="TestDumpPoint"{print $1}')
+REGS=$(arm-none-eabi-nm "poke$GAME.elf" | awk '$3=="sGpuRegBuffer"{print $1}')
+"$MGBA" -g "poke$GAME.gba" > /dev/null 2>&1 &
+MGBA_PID=$!
+rm -rf "$HERE/out"
+python3 -I "$HERE/gdb_dump.py" "$BP" "$HERE/out" 9 "$REGS"
+for f in "$HERE"/out/*.bin; do
+    python3 -I "$HERE/render_gba.py" "$f" "${f%.bin}.png"
+    rm "$f"
+done
+echo "Screens written to $HERE/out/"
